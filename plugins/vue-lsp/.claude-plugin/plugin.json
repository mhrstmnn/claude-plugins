{
  "name": "vue-lsp",
  "version": "0.2.0",
  "description": "Vue language server for code intelligence in .vue files, next to typescript-lsp: typescript-language-server with Vue's TypeScript plugin",
  "author": {
    "name": "Michael Horstmann"
  },
  "homepage": "https://github.com/mhrstmnn/claude-plugins/tree/main/plugins/vue-lsp",
  "repository": "https://github.com/mhrstmnn/claude-plugins",
  "license": "MIT",
  "keywords": ["vue", "typescript", "lsp", "language-server"],
  "lspServers": {
    "vue": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/server/main.ts"],
      "extensionToLanguage": {
        ".vue": "vue"
      },
      "startupTimeout": 300000
    }
  }
}
