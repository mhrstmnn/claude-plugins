{
  "name": "claude-plugins",
  "version": "0.1.0",
  "private": true,
  "description": "Plugins for Claude Code, and the marketplace that lists them",
  "license": "MIT",
  "author": "Michael Horstmann",
  "type": "module",
  "scripts": {
    "typecheck": "tsc",
    "lint": "oxlint",
    "format": "oxfmt",
    "check": "tsc && oxlint && oxfmt --check",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "vue": "^3.5.44"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "packageManager": "pnpm@12.15.0"
}
